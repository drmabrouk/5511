        // دالة تحديث تواريخ الإصدار والانتهاء
        function updateDates() {
            const issueInput = document.getElementById('issue-date').value;
            let issueDate = issueInput ? new Date(issueInput) : new Date();

            const formatDate = (date) => {
                let d = date.getDate().toString().padStart(2, '0');
                let m = (date.getMonth() + 1).toString().padStart(2, '0');
                let y = date.getFullYear();
                return `${d}/${m}/${y}`;
            };

            const expiryDate = new Date(issueDate);
            expiryDate.setFullYear(issueDate.getFullYear() + 1);

            const issueFormatted = formatDate(issueDate);
            const expiryFormatted = formatDate(expiryDate);

            CURRENT_EXPIRY_DATE = expiryFormatted;

            document.getElementById('view-footer-issue').innerText = `تحريراً في: ${toArabicDigits(issueFormatted)} / Issued on: ${issueFormatted}`;
            document.getElementById('view-footer-expiry').innerText = `صالح حتى: ${toArabicDigits(expiryFormatted)} / Valid until: ${expiryFormatted}`;
        }

