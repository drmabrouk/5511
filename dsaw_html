        // --- نظام إدارة الجلسة والتخزين الدائم (Session & Storage Management) ---
        let storageDirHandle = null;
        let DATABASE = [];
        let currentDbName = "syndicate_database.json";
        let APP_CONFIG = {
            logo: null,
            watermark: null,
            watermarkOpacityCustom: 0.1,
            watermarkOpacitySystem: 0.1,
            electronicIssuance: false,
            electronicSignature: false,
            signatureImage: null
        };
        let CURRENT_EXPIRY_DATE = ""; // لتخزين تاريخ انتهاء التصريح الحالي

        // استخدام IndexedDB لحفظ مقبض المجلد (Directory Handle) بشكل دائم
        const DB_SESSION_NAME = "SyndicateSession";
        const STORE_NAME = "Handles";

        function getDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_SESSION_NAME, 1);
                request.onupgradeneeded = () => request.result.createObjectStore(STORE_NAME);
                request.onsuccess = () => resolve(request.result);
                request.onerror = () => reject(request.error);
            });
        }

        async function saveHandle(handle) {
            const db = await getDB();
            const tx = db.transaction(STORE_NAME, "readwrite");
            await tx.objectStore(STORE_NAME).put(handle, "lastDirectory");
        }

        async function loadHandle() {
            const db = await getDB();
            return await db.transaction(STORE_NAME).objectStore(STORE_NAME).get("lastDirectory");
        }

        async function verifyPermission(handle) {
            if ((await handle.queryPermission({ mode: 'readwrite' })) === 'granted') return true;
            if ((await handle.requestPermission({ mode: 'readwrite' })) === 'granted') return true;
            return false;
        }

        async function selectDirectory() {
            try {
                storageDirHandle = await window.showDirectoryPicker({ mode: 'readwrite' });
                await saveHandle(storageDirHandle);
                await initializeSystem();
            } catch (err) {
                console.error('Directory selection failed:', err);
            }
        }

        async function initializeSystem() {
            if (!storageDirHandle) return;

            try {
                // تحديث حالة زر التخزين
                const btn = document.getElementById('btn-storage');
                const label = document.getElementById('storage-label');
                const pathSpan = document.getElementById('storage-path');
                const icon = document.getElementById('storage-icon');

                btn.style.background = "var(--secondary-green)";
                label.innerHTML = "✓ مجلد التخزين متصل";
                pathSpan.innerText = storageDirHandle.name;
                icon.innerHTML = '<polyline points="20 6 9 17 4 12"></polyline>';

                await loadConfig();
                await refreshDatabaseList();
                const selector = document.getElementById('db-selector');
                if (selector.options.length > 1) {
                    const firstDb = selector.options[1].value;
                    await switchDatabase(firstDb);
                } else {
                    await switchDatabase(currentDbName);
                }

                // تفعيل النظام
                document.body.classList.remove('system-locked');
                console.log("System initialized and unlocked.");
            } catch (err) {
                console.error("Initialization failed:", err);
            }
        }

        async function loadConfig() {
            try {
                const fileHandle = await storageDirHandle.getFileHandle("config.json", { create: true });
                const file = await fileHandle.getFile();
                const text = await file.text();
                if (text) {
                    const savedConfig = JSON.parse(text);
                    APP_CONFIG = { ...APP_CONFIG, ...savedConfig };

                    if (APP_CONFIG.logo) {
                        document.getElementById('logo-preview').src = APP_CONFIG.logo;
                    }

                    if (APP_CONFIG.watermarkOpacityCustom !== undefined) {
                        const val = APP_CONFIG.watermarkOpacityCustom;
                        document.getElementById('watermark-opacity-custom').value = val;
                        const custom = document.getElementById('view-custom-watermark');
                        if (custom) custom.style.opacity = val;
                    }

                    if (APP_CONFIG.watermarkOpacitySystem !== undefined) {
                        const val = APP_CONFIG.watermarkOpacitySystem;
                        document.getElementById('watermark-opacity-system').value = val;
                        const system = document.getElementById('watermark-system');
                        if (system) system.style.opacity = val;
                    }

                    if (APP_CONFIG.watermark) {
                        const output = document.getElementById('view-custom-watermark');
                        output.src = APP_CONFIG.watermark;
                        output.style.display = 'block';
                    }

                    if (APP_CONFIG.electronicIssuance !== undefined) {
                        const check = document.getElementById('check-electronic');
                        check.checked = APP_CONFIG.electronicIssuance;
                        document.getElementById('view-electronic-disclaimer').style.display = APP_CONFIG.electronicIssuance ? 'block' : 'none';
                    }
                    if (APP_CONFIG.electronicSignature !== undefined) {
                        const checkSig = document.getElementById('check-signature');
                        if (checkSig) checkSig.checked = APP_CONFIG.electronicSignature;

                        const uploadBox = document.getElementById('signature-upload-box');
                        if (uploadBox) uploadBox.style.display = APP_CONFIG.electronicSignature ? 'block' : 'none';

                        const sigText = document.getElementById('view-signature');
                        const sigImg = document.getElementById('view-signature-img');

                        if (APP_CONFIG.electronicSignature) {
                            if (APP_CONFIG.signatureImage) {
                                if (sigImg) { sigImg.src = APP_CONFIG.signatureImage; sigImg.style.display = 'block'; }
                                if (sigText) sigText.style.display = 'none';
                            } else {
                                if (sigText) sigText.style.display = 'block';
                                if (sigImg) sigImg.style.display = 'none';
                            }
                        }
                    }
                }
            } catch (err) { console.log("Config not found or invalid."); }
        }

        async function saveConfig() {
            try {
                const fileHandle = await storageDirHandle.getFileHandle("config.json", { create: true });
                const writable = await fileHandle.createWritable();
                await writable.write(JSON.stringify(APP_CONFIG, null, 2));
                await writable.close();
            } catch (err) { console.error("Failed to save config:", err); }
        }

        async function autoRestoreSession() {
            try {
                const request = await loadHandle();
                request.onsuccess = async () => {
                    const handle = request.result;
                    if (handle) {
                        // طلب إذن الوصول مرة أخرى (متطلب أمني للمتصفح)
                        if (await verifyPermission(handle)) {
                            storageDirHandle = handle;
                            await initializeSystem();
                        }
                    }
                };
            } catch (err) {
                console.log("No previous session found.");
            }
        }

        async function refreshDatabaseList() {
            if (!storageDirHandle) return;
            const selector = document.getElementById('db-selector');
            selector.innerHTML = '<option value="">اختر قاعدة بيانات...</option>';

            try {
                for await (const entry of storageDirHandle.values()) {
                    if (entry.kind === 'file' && entry.name.endsWith('.json')) {
                        const opt = document.createElement('option');
                        opt.value = entry.name;
                        opt.innerText = entry.name;
                        selector.appendChild(opt);
                    }
                }
            } catch (err) {
                console.error("Error listing files:", err);
            }
