        // دالة ملء القوائم المنسدلة ديناميكياً
        function populateDropdowns() {
            const populate = (id, items, separator = " - ", defaultText = "اختر...") => {
                const select = document.getElementById(id);
                select.innerHTML = `<option value="">${defaultText}</option>`;
                items.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = `${item.ar}${separator}${item.en}`;
                    opt.innerText = `${item.ar} - ${item.en}`;
                    select.appendChild(opt);
                });
            };

            populate("uni", DATA_REGISTRY.universities);
            populate("branch", DATA_REGISTRY.branches);
            populate("qual", DATA_REGISTRY.qualifications, " | ");
            populate("rank", DATA_REGISTRY.ranks);
            populate("spec", DATA_REGISTRY.specializations);
        }

        // دالة تحويل الأرقام إلى الأرقام العربية (المشرقية)
        function toArabicDigits(num) {
            const id = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
            return num.toString().replace(/[0-9]/g, function (w) {
                return id[+w];
            });
        }

        // دالة تحديث النصوص اللحظية
        function updateText(id, val) {
            const targetAr = document.getElementById('view-' + id + '-ar');
            const targetEn = document.getElementById('view-' + id + '-en');

            // Handle split values for specific fields (University, Branch) if they contain " - "
            if (val.includes(" - ")) {
                const parts = val.split(" - ");
                if (targetAr) targetAr.innerText = parts[0];
                if (targetEn) targetEn.innerText = parts[1];
                return;
            }

            if (val.trim() === "") {
                if (targetAr) targetAr.innerText = "---";
                if (targetEn) targetEn.innerText = "---";
                // Fallback for names which don't have -ar/-en suffix in updateText call
                const direct = document.getElementById(id);
                if (direct) direct.innerText = "---";
            } else {
                if (targetAr) targetAr.innerText = toArabicDigits(val);
                if (targetEn) targetEn.innerText = val;
                const direct = document.getElementById(id);
                if (direct) direct.innerText = val;
            }
        }

        // تحديث الدرجة المهنية والتخصص معاً
        function updateRankAndSpec() {
            const rankVal = document.getElementById('rank').value;
            const specVal = document.getElementById('spec').value;

            const arSpan = document.getElementById('view-rank-ar');
            const enSpan = document.getElementById('view-rank-en');

            let arRank = "---", enRank = "---";
            let arSpec = "", enSpec = "";

            if (rankVal.includes(" - ")) {
                const p = rankVal.split(" - ");
                arRank = p[0];
                enRank = p[1];
            }

            if (specVal.includes(" - ")) {
                const p = specVal.split(" - ");
                arSpec = p[0];
                enSpec = p[1];
            }

            arSpan.innerText = arSpec ? `${arRank} (${arSpec})` : arRank;
            enSpan.innerText = enSpec ? `${enRank} (${enSpec})` : enRank;
        }

        // تحديث معلومات المؤهل الدراسي
        function updateQualInfo() {
            const val = document.getElementById('qual').value;
            const arSpan = document.getElementById('view-qual-ar');
            const enSpan = document.getElementById('view-qual-en');
            if (val.includes(" | ")) {
                const parts = val.split(" | ");
                arSpan.innerText = parts[0];
                enSpan.innerText = parts[1];
            } else {
                arSpan.innerText = val || '---';
                enSpan.innerText = val || '---';
            }
        }

        // تحديث فرع النقابة والبريد الإلكتروني
        function updateBranch(val) {
            const arSpan = document.getElementById("view-branch-ar");
            const enSpan = document.getElementById("view-branch-en");
            const emailAr = document.getElementById("view-email-ar");
            const emailEn = document.getElementById("view-email-en");

            let branchEn = "";
            if (val.includes(" - ")) {
                const parts = val.split(" - ");
                arSpan.innerText = parts[0];
                enSpan.innerText = parts[1];
                branchEn = parts[1];
            } else {
                arSpan.innerText = "";
                enSpan.innerText = "";
            }

            // تحديث البريد الإلكتروني ديناميكياً
            let email = "info@irseg.org"; // الافتراضي
            if (branchEn === "Cairo") email = "info@irseg.org";
            else if (branchEn === "Monufia") email = "menofia@irseg.org";

            emailAr.innerText = email;
            emailEn.innerText = email;
        }

        // معالجة وتحميل الصور (الشعار و QR)
        function loadImage(event, targetId) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function() {
                const output = document.getElementById(targetId);
                output.src = reader.result;
                output.style.border = "none";
            }
            reader.readAsDataURL(file);
        }

        // --- نظام التخزين المحلي وقاعدة البيانات (Local Database & Storage System) ---
        let storageDirHandle = null;
        let DATABASE = [];
        let currentDbName = "syndicate_database.json";

        async function selectDirectory() {
            try {
                storageDirHandle = await window.showDirectoryPicker();
                await refreshDatabaseList();
                if (document.getElementById('db-selector').options.length > 1) {
                    // Load the first available database if it exists
                    const firstDb = document.getElementById('db-selector').options[1].value;
                    await switchDatabase(firstDb);
                } else {
                    await switchDatabase(currentDbName);
                }
                alert('تم الاتصال بالمجلد بنجاح.');
            } catch (err) {
                console.error('Directory selection failed:', err);
            }
        }

        async function refreshDatabaseList() {
            if (!storageDirHandle) return;
            const selector = document.getElementById('db-selector');
            selector.innerHTML = '<option value="">اختر قاعدة بيانات...</option>';

            try {
                for await (const entry of storageDirHandle.values()) {
                    if (entry.kind === 'file' && entry.name.endsWith('.json')) {
                        const opt = document.createElement('option');
                        opt.value = entry.name;
                        opt.innerText = entry.name;
                        selector.appendChild(opt);
                    }
                }
            } catch (err) {
                console.error("Error listing files:", err);
            }
        }

        async function switchDatabase(dbName) {
            if (!dbName || !storageDirHandle) return;
            currentDbName = dbName;
            document.getElementById('db-selector').value = dbName;
            await loadDatabase();
        }

        async function createNewDatabase() {
            if (!storageDirHandle) {
                alert('يرجى تحديد المجلد أولاً.');
                return;
            }
            const name = prompt("أدخل اسم قاعدة البيانات الجديدة (بدون .json):");
            if (name) {
                const fileName = name.endsWith('.json') ? name : name + '.json';
                currentDbName = fileName;
                await saveToDatabase([]); // Create empty file
                await refreshDatabaseList();
                await switchDatabase(fileName);
            }
        }

        async function loadDatabase() {
            if (!storageDirHandle) return;
            try {
                const fileHandle = await storageDirHandle.getFileHandle(currentDbName, { create: true });
                const file = await fileHandle.getFile();
                const text = await file.text();
                DATABASE = (text && text.trim() !== "") ? JSON.parse(text) : [];
                console.log(`Database [${currentDbName}] loaded:`, DATABASE.length, "records");
            } catch (err) {
                console.error("Failed to load database:", err);
                DATABASE = [];
            }
        }

        async function saveToDatabase(entry = null) {
            if (!storageDirHandle) return;

            if (entry && !Array.isArray(entry)) {
                // Update or Add single record
                const index = DATABASE.findIndex(r => r.nid === entry.nid);
                if (index !== -1) {
                    DATABASE[index] = entry;
                } else {
                    DATABASE.push(entry);
                }
            } else if (Array.isArray(entry)) {
                DATABASE = entry;
            }

            try {
                const fileHandle = await storageDirHandle.getFileHandle(currentDbName, { create: true });
                const writable = await fileHandle.createWritable();
                await writable.write(JSON.stringify(DATABASE, null, 2));
                await writable.close();
            } catch (err) {
                console.error("Failed to save database index:", err);
            }
        }

        async function saveDocumentLocally() {
            if (!storageDirHandle) {
                alert('يرجى تحديد مجلد التخزين أولاً.\nPlease select a storage folder first.');
                return;
            }

            const formData = {
                nid: document.getElementById('nid-no').value,
                nameAr: document.getElementById('name-ar').value,
                nameEn: document.getElementById('name-en').value,
                uni: document.getElementById('uni').value,
                qual: document.getElementById('qual').value,
                rank: document.getElementById('rank').value,
                spec: document.getElementById('spec').value,
                branch: document.getElementById('branch').value,
                pNo: document.getElementById('p-no').value,
                rNo: document.getElementById('r-no').value,
                mNo: document.getElementById('m-no').value,
                timestamp: new Date().toISOString()
            };

            if (!formData.nid || formData.nid.length !== 14) {
                alert('يرجى إدخال رقم الهوية الوطنية بشكل صحيح (14 رقم).');
                return;
            }

            try {
                // 1. حفظ ملف الـ HTML الفردي (للطباعة والأرشفة)
                const fileName = `${formData.nid}.html`;
                const fileHandle = await storageDirHandle.getFileHandle(fileName, { create: true });
                const writable = await fileHandle.createWritable();
                const content = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                await writable.write(content);
                await writable.close();

                // 2. تحديث الفهرس المركزي (JSON)
                await saveToDatabase(formData);

                console.log(`Record for ${formData.nid} saved and indexed.`);
            } catch (err) {
                console.error('Save failed:', err);
                alert('فشل في حفظ السجل.');
            }
        }

        async function handlePrint() {
            await saveDocumentLocally();
            window.print();
        }

        // نظام البحث والفلترة
        function handleSearch(query) {
            const resultsDiv = document.getElementById('search-results');
            if (!query || query.length < 5) {
                resultsDiv.style.display = 'none';
                return;
            }

            const matches = DATABASE.filter(r =>
                r.nid.includes(query) ||
                (r.nameAr && r.nameAr.includes(query)) ||
                (r.nameEn && r.nameEn.toLowerCase().includes(query.toLowerCase()))
            );

            if (matches.length > 0) {
                resultsDiv.innerHTML = matches.map(r => `
                    <div class="search-item" onclick="loadRecord('${r.nid}')">
                        <strong>${r.nameAr || 'بدون اسم'}</strong>
                        <div class="meta">${r.nid} | ${r.pNo || '---'}</div>
                    </div>
                `).join('');
                resultsDiv.style.display = 'block';
            } else {
                resultsDiv.innerHTML = '<div class="search-item" style="color:#999">لا توجد نتائج مطابقة...</div>';
                resultsDiv.style.display = 'block';
            }
        }

        function loadRecord(nid) {
            const record = DATABASE.find(r => r.nid === nid);
            if (!record) return;

            // ملء النموذج
            document.getElementById('nid-no').value = record.nid;
            document.getElementById('name-ar').value = record.nameAr || '';
            document.getElementById('name-en').value = record.nameEn || '';
            document.getElementById('uni').value = record.uni || '';
            document.getElementById('qual').value = record.qual || '';
            document.getElementById('rank').value = record.rank || '';
            document.getElementById('spec').value = record.spec || '';
            document.getElementById('branch').value = record.branch || '';
            document.getElementById('p-no').value = record.pNo || '';
            document.getElementById('r-no').value = record.rNo || '';
            document.getElementById('m-no').value = record.mNo || '';

            // تحديث المعاينة
            updateText('nid-no', record.nid);
            updateText('view-name-ar', record.nameAr);
            updateText('view-name-en', record.nameEn);
            updateText('uni', record.uni);
            updateQualInfo();
            updateRankAndSpec();
            updateBranch(record.branch);
            updateText('p-no', record.pNo);
            updateText('r-no', record.rNo);
            updateText('m-no', record.mNo);

            document.getElementById('search-results').style.display = 'none';
            document.getElementById('search-db').value = '';
        }

        // الأتمتة الزمنية عند تحميل الصفحة
        window.onload = function() {
            populateDropdowns();
            const today = new Date();
            const expiry = new Date();
            expiry.setFullYear(today.getFullYear() + 1);

            const formatDate = (date) => {
                let d = date.getDate().toString().padStart(2, '0');
                let m = (date.getMonth() + 1).toString().padStart(2, '0');
                let y = date.getFullYear();
                return `${d}/${m}/${y}`;
            };

            const expiryFormatted = formatDate(expiry);
            document.getElementById('view-expiry-date-ar').innerText = toArabicDigits(expiryFormatted);
            document.getElementById('view-expiry-date-en').innerText = expiryFormatted;
        };
