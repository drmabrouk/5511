<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إصدار تصاريح مزاولة المهنة الاحترافي - V2.0</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;500;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #7b0000; /* أحمر خمري رسمي */
            --secondary-green: #004d40; /* أخضر غامق مؤسسي */
            --text-dark: #111;
            --watermark-color: rgba(220, 220, 220, 0.15); /* لون الخلفية المائية دقيق جداً */
            --bg-control: #f0f2f5;
        }

        * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body { font-family: 'Tajawal', sans-serif; margin: 0; background: var(--bg-control); display: flex; height: 100vh; overflow: hidden; color: var(--text-dark); }

        /* --- لوحة التحكم (Sidebar) --- */
        .sidebar {
            width: 380px; min-width: 380px; background: #fff; padding: 20px;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05); overflow-y: auto; z-index: 10;
            display: flex; flex-direction: column;
        }

        .sidebar-header { text-align: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        .sidebar-header h2 { color: var(--primary-dark); margin: 0; font-size: 1.3rem; font-weight: 800; }
        .sidebar-header p { color: #666; margin: 5px 0 0; font-size: 0.9rem; }

        /* البحث المتقدم */
        .search-container { position: relative; margin-bottom: 20px; }
        .search-input {
            width: 100%; padding: 12px 15px; border: 2px solid var(--primary-dark);
            border-radius: 8px; font-family: 'Tajawal'; font-size: 0.95rem;
            background: #fff; transition: 0.3s;
        }
        .search-input:focus { outline: none; box-shadow: 0 0 10px rgba(123,0,0,0.1); }
        .search-results {
            position: absolute; top: 100%; left: 0; right: 0; background: #fff;
            border: 1px solid #ddd; border-top: none; border-radius: 0 0 8px 8px;
            max-height: 250px; overflow-y: auto; z-index: 100; display: none;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .search-item {
            padding: 10px 15px; cursor: pointer; border-bottom: 1px solid #f5f5f5;
            transition: 0.2s; font-size: 0.85rem;
        }
        .search-item:hover { background: #f9f9f9; color: var(--primary-dark); }
        .search-item .meta { font-size: 0.75rem; color: #888; margin-top: 3px; }

        fieldset { border: 1px solid #eee; border-radius: 8px; padding: 15px; margin-bottom: 20px; }
        legend {
            padding: 0 10px; font-weight: 800; font-size: 0.85rem; color: var(--secondary-green);
            text-transform: uppercase; letter-spacing: 0.5px;
        }

        .input-group { margin-bottom: 12px; }
        .input-group label { display: block; margin-bottom: 4px; font-weight: 500; font-size: 0.85rem; color: #444; }
        .input-group input, .input-group select {
            width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-family: 'Tajawal'; font-size: 0.9rem; transition: 0.2s;
        }
        .input-group input:focus, .input-group select:focus { border-color: var(--secondary-green); outline: none; box-shadow: 0 0 0 3px rgba(0,77,64,0.1); }

        .row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .action-controls {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: auto;
            padding-top: 15px;
            border-top: 1px solid #eee;
        }

        .btn-action {
            padding: 12px; border: none; border-radius: 8px; cursor: pointer;
            font-weight: 700; font-size: 0.95rem; transition: 0.3s;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
        }

        .btn-print-only { background: var(--primary-dark); color: white; }
        .btn-print-only:hover { background: #5a0000; transform: translateY(-2px); }

        .btn-save-as { background: var(--secondary-green); color: white; }
        .btn-save-as:hover { background: #00332a; transform: translateY(-2px); }

        .btn-storage { background: #455a64; color: white; margin-bottom: 10px; }
        .btn-storage:hover { background: #263238; }

        .btn-action span { font-size: 0.75rem; font-weight: 400; opacity: 0.9; }

        /* --- منطقة المعاينة (Preview) --- */
        .preview-area {
            flex-grow: 1; padding: 20px; display: flex; justify-content: center;
            align-items: flex-start; overflow-y: auto; background: #525659; /* لون خلفية عارض الملفات */
        }

        /* هيكلية وثيقة A4 - بدون إطارات */
        .a4-page {
            width: 210mm; height: 297mm; background: white; position: relative;
            box-shadow: 0 0 35px rgba(0,0,0,0.25); overflow: hidden;
            display: flex; flex-direction: column;
        }

        /* --- نظام خلفية مائية أمنية متموجة (Advanced Security Wave-Style Watermark) --- */
        .security-watermark {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml;charset=UTF-8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 1414' preserveAspectRatio='none'><defs><linearGradient id='waveGrad' x1='0%25' y1='0%25' x2='100%25' y2='100%25'><stop offset='0%25' stop-color='%237b0000' stop-opacity='0.04' /><stop offset='50%25' stop-color='%23004d40' stop-opacity='0.01' /><stop offset='100%25' stop-color='%237b0000' stop-opacity='0.04' /></linearGradient><pattern id='microText' x='0' y='0' width='350' height='100' patternUnits='userSpaceOnUse' patternTransform='rotate(-15)'><text x='10' y='30' font-family='Arial, sans-serif' font-size='7' font-weight='600' fill='black' fill-opacity='0.015'>Injuries and Rehabilitation Syndicate</text><text x='150' y='80' font-family='Arial, sans-serif' font-size='7' font-weight='600' fill='black' fill-opacity='0.015'>Injuries and Rehabilitation Syndicate</text></pattern><radialGradient id='securityZone' cx='50%25' cy='50%25' r='40%25'><stop offset='0%25' stop-color='%237b0000' stop-opacity='0.05' /><stop offset='100%25' stop-color='%237b0000' stop-opacity='0' /></radialGradient></defs><rect width='100%25' height='100%25' fill='url(%23microText)' /><circle cx='500' cy='350' r='250' fill='url(%23securityZone)' /><circle cx='200' cy='1100' r='180' fill='url(%23securityZone)' opacity='0.5'/><circle cx='800' cy='1100' r='180' fill='url(%23securityZone)' opacity='0.5'/><g fill='none' stroke='url(%23waveGrad)' stroke-width='30' stroke-linecap='round' filter='blur(35px)'><path d='M-100,300 C200,100 400,500 600,300 S1000,100 1100,300' opacity='0.4'/><path d='M-100,700 C200,500 400,900 600,700 S1000,500 1100,700' opacity='0.3'/><path d='M-100,1100 C200,900 400,1300 600,1100 S1000,900 1100,1100' opacity='0.4'/></g><g fill='none' stroke='%23004d40' stroke-width='0.6' opacity='0.1' stroke-dasharray='1 2'><path d='M-50,100 C150,250 350,50 550,150 S850,250 1050,100' /><path d='M-50,400 C150,550 350,350 550,450 S850,550 1050,400' /><path d='M-50,700 C150,850 350,650 550,750 S850,850 1050,700' /><path d='M-50,1000 C150,1150 350,950 550,1050 S850,1150 1050,1000' /></g></svg>");
            background-size: cover;
            pointer-events: none; z-index: 1;
        }

        /* المحتوى الفعلي للمستند */
        .doc-content {
            position: relative; z-index: 2;
            padding: 12mm 10mm;
            height: 100%; display: flex; flex-direction: column;
        }

        .doc-content::before {
            content: ''; position: absolute; top: 0; left: 15mm; right: 15mm; height: 4px;
            background: linear-gradient(to right, var(--primary-dark), var(--secondary-green), var(--primary-dark));
            border-radius: 0 0 4px 4px;
        }

        /* الهيدر */
        .header {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 15px; padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .header-text { width: 38%; }
        .header-text.ar { text-align: right; font-family: 'Amiri', serif; font-size: 12.5pt; line-height: 1.4; }
        .header-text.en { text-align: left; font-family: 'Cambria', 'Georgia', serif; font-size: 11.5pt; line-height: 1.4; direction: ltr; }

        .logo-area { width: 24%; text-align: center; align-self: center; }
        #logo-preview { max-width: 80px; max-height: 80px; object-fit: contain; }

        /* عنوان الوثيقة */
        .doc-title { text-align: center; margin-bottom: 15px; }
        .doc-title h1 { margin: 0; color: var(--primary-dark); font-size: 24pt; font-family: 'Amiri', serif; font-weight: 700; letter-spacing: 0.5px; }
        .doc-title p { margin: 2px 0 0; font-size: 14pt; color: #555; font-weight: 300; text-transform: uppercase; letter-spacing: 1.5px; }

        /* بيانات العضو الرئيسية */
        .member-name-zone { text-align: center; margin-bottom: 15px; position: relative; padding: 5px 0; }
        #view-name-ar { font-size: 19pt; font-weight: 800; color: #000; font-family: 'Tajawal', sans-serif; }
        #view-name-en { font-size: 13pt; color: #444; margin-top: 5px; font-family: 'Cambria', serif; font-weight: 400; font-style: italic; }
        .member-qual-zone { font-size: 10pt; color: #555; margin-top: 8px; font-weight: 500; }

        /* شبكة البيانات الفنية */
        .data-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px;
            margin-top: 10px; border-top: 1px solid #eee; padding-top: 10px;
        }

        .data-item {
            border-bottom: 1px solid #f5f5f5; padding: 8px 0;
            display: flex; justify-content: space-between; align-items: baseline;
        }

        .data-item .label-pair { display: flex; flex-direction: column; text-align: right; }
        .data-item .label-ar { font-weight: 700; color: var(--secondary-green); font-size: 10pt; }
        .data-item .label-en { font-weight: 400; color: #777; font-size: 8.5pt; direction: ltr; text-align: right; }

        .value-stack { display: flex; flex-direction: column; align-items: flex-end; text-align: right; gap: 2px; }
        .value-ar { font-weight: 700; font-size: 11.5pt; color: #000; font-family: 'Tajawal', sans-serif; }
        .value-en { font-weight: 500; font-size: 9.5pt; color: #555; font-family: 'Cambria', serif; direction: ltr; }
        .value-num-ar { font-family: 'Amiri', serif; font-size: 12pt; }
        .value-num-en { font-family: 'Courier New', Courier, monospace; font-size: 11pt; }

        .nationality-text { font-size: 9pt; color: #666; font-weight: 500; margin-top: 2px; }

        /* النص القانوني */
        .legal-text {
            margin-top: 15px; font-size: 9pt; line-height: 1.6; color: #444; text-align: justify;
            background: rgba(245, 245, 245, 0.5); padding: 12px; border-radius: 4px; border-right: 3px solid var(--secondary-green);
        }

        /* الفوتر */
        .footer-assets {
            margin-top: auto; display: flex; justify-content: space-between; margin-bottom: 10px;
            align-items: flex-end; padding-top: 10px; border-top: 1px solid #eee;
        }

        .qr-box { width: 110px; text-align: center; }
        #qr-preview { width: 90px; height: 90px; border: 1px solid #eaeaea; padding: 2px; background: #fff; }
        .qr-box p { font-size: 7.5pt; margin: 5px 0 0; color: #777; line-height: 1.2; }

        .signature-box { text-align: center; min-width: 200px; color: var(--text-dark); }
        .signature-box .sig-line { border-top: 1.5px solid #333; margin-top: 45px; width: 100%; display: block; }
        .signature-box p { margin: 8px 0 0; font-weight: 700; font-size: 10.5pt; }
        .signature-box small { font-size: 8.5pt; color: #555; }

        .verification-footer {
            text-align: center;
            font-size: 7.5pt;
            color: #888;
            border-top: 1px dashed #eee;
            padding-top: 8px;
            margin-top: 5px;
        }

        /* --- إعدادات الطباعة الاحترافية (Professional A4 Print Logic) --- */
        @page {
            size: A4;
            margin: 0;
        }

        @media print {
            body { background: white; margin: 0; padding: 0; }
            .sidebar { display: none !important; }
            .preview-area { padding: 0; margin: 0; background: white; overflow: visible; display: block; }
            .a4-page {
                box-shadow: none; border: none;
                width: 210mm; height: 297mm;
                margin: 0 auto; page-break-after: always;
                position: relative;
                top: 0; left: 0;
            }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <h2>بوابة إدارة التصاريح</h2>
            <p>نظام ذكي لإدارة وإصدار المستندات الرسمية</p>
        </div>

        <!-- نظام البحث المتقدم والتحكم في قاعدة البيانات -->
        <div class="search-container">
            <div class="input-group" style="margin-bottom: 10px;">
                <label style="font-size: 0.75rem;">قاعدة البيانات النشطة / Active Database</label>
                <div style="display: flex; gap: 5px;">
                    <select id="db-selector" style="flex-grow: 1; padding: 5px;" onchange="switchDatabase(this.value)">
                        <option value="">لا يوجد مجلد مختار...</option>
                    </select>
                    <button onclick="createNewDatabase()" title="إنشاء قاعدة جديدة" style="padding: 5px 10px; cursor: pointer; border: 1px solid #ddd; border-radius: 4px;">+</button>
                </div>
            </div>
            <input type="text" id="search-db" class="search-input" placeholder="ابحث بالاسم أو الرقم القومي (5+ حروف)..." oninput="handleSearch(this.value)">
            <div id="search-results" class="search-results"></div>
        </div>

        <form id="cert-form">
            <fieldset>
                <legend>البيانات الشخصية / Personal Info</legend>
                <div class="input-group">
                    <label>رقم الهوية الوطنية / National ID</label>
                    <input type="text" id="nid-no" maxlength="14" placeholder="29001011234567" oninput="this.value = this.value.replace(/[^0-9]/g, ''); updateText('nid-no', this.value)">
                </div>
                <div class="input-group">
                    <label>الاسم الرباعي (عربي)</label>
                    <input type="text" id="name-ar" placeholder="محمد أحمد محمود علي" oninput="updateText('view-name-ar', this.value)">
                </div>
                <div class="input-group">
                    <label>Full Name (English)</label>
                    <input type="text" id="name-en" style="direction: ltr;" placeholder="Mohamed A. Mahmoud Ali" oninput="updateText('view-name-en', this.value)">
                </div>
            </fieldset>

            <fieldset>
                <legend>البيانات الأكاديمية والمهنية</legend>
                <div class="input-group">
                    <label>اسم الجامعة / University</label>
                    <select id="uni" onchange="updateText('uni', this.value)">
                        <option value="">جاري التحميل...</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>المؤهل الدراسي / Qualification</label>
                    <select id="qual" onchange="updateQualInfo()">
                        <option value="">جاري التحميل...</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>الدرجة المهنية / Rank</label>
                    <select id="rank" onchange="updateRankAndSpec()">
                        <option value="">جاري التحميل...</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>التخصص / Specialization</label>
                    <select id="spec" onchange="updateRankAndSpec()">
                        <option value="">جاري التحميل...</option>
                    </select>
                </div>
            </fieldset>

            <fieldset>
                <legend>بيانات التصريح والانتساب</legend>
                <div class="input-group">
                    <label>فرع النقابة / Branch</label>
                    <select id="branch" onchange="updateBranch(this.value)">
                        <option value="">جاري التحميل...</option>
                    </select>
                </div>
                <div class="row-inputs">
                    <div class="input-group">
                        <label>رقم التصريح</label>
                        <input type="text" id="p-no" placeholder="P-2023-001" oninput="updateText('p-no', this.value)">
                    </div>
                    <div class="input-group">
                        <label>رقم القيد</label>
                        <input type="text" id="r-no" placeholder="R-10550" oninput="updateText('r-no', this.value)">
                    </div>
                </div>
                <div class="input-group">
                    <label>رقم العضوية (Membership)</label>
                    <input type="text" id="m-no" placeholder="M-9980" oninput="updateText('m-no', this.value)">
                </div>
            </fieldset>

            <fieldset>
                <legend>الوسائط الرقمية / Media</legend>
                <div class="input-group">
                    <label>شعار النقابة الرسمي</label>
                    <input type="file" id="logo-input" accept="image/*" onchange="loadImage(event, 'logo-preview')">
                </div>
                <div class="input-group">
                    <label>رمز التحقق (QR Code)</label>
                    <input type="file" id="qr-input" accept="image/*" onchange="loadImage(event, 'qr-preview')">
                </div>
            </fieldset>
        </form>

        <div style="margin-top: 15px; font-size: 0.8rem; color: #666; background: #f9f9f9; padding: 10px; border-radius: 4px; border: 1px solid #eee;">
            <strong>ملاحظة زمنية:</strong> صلاحية التصريح سنة واحدة من تاريخه.
        </div>

        <button class="btn-action btn-storage" onclick="selectDirectory()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
            تحديد مجلد التخزين
            <span>Set Storage Folder</span>
        </button>

        <div class="action-controls">
            <button class="btn-action btn-print-only" onclick="handlePrint()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
                طباعة وحفظ
                <span>Print & Save</span>
            </button>
            <button class="btn-action btn-save-as" onclick="saveDocumentLocally()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                حفظ تلقائي
                <span>Auto Save</span>
            </button>
        </div>
    </div>

    <div class="preview-area">
        <div class="a4-page" id="printable">
            <div class="security-watermark"></div>

            <div class="doc-content">

                <div class="header">
                    <div class="header-text ar">
                        <strong>جمهورية مصر العربية</strong><br>
                        نقابة الإصابات والتأهيل<br>
                        <span id="view-branch-ar" style="font-weight: bold; color: var(--secondary-green);"></span><br>
                    </div>
                    <div class="logo-area">
                        <img id="logo-preview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'> <circle cx='50' cy='50' r='45' stroke='%237b0000' stroke-width='2' fill='none'/><path d='M30 70 L50 30 L70 70 M50 30 L50 70' stroke='%23004d40' stroke-width='3' fill='none'/></svg>" alt="Logo">
                    </div>
                    <div class="header-text en">
                        <strong>Arab Republic of Egypt</strong><br>
                        Injuries and Rehabilitation Syndicate<br>
                        <span id="view-branch-en" style="font-weight: bold; color: var(--secondary-green);"></span><br>
                    </div>
                </div>

                <div class="doc-title">
                    <h1>تصريح مزاولة مهنة</h1>
                    <p>Professional Practice Permit</p>
                </div>

                <div class="member-name-zone">
                    <div id="view-name-ar">اسم العضو الكريم الرباعي</div>
                    <div id="view-name-en">Member Full English Name</div>
                    <div class="nationality-text">مصري الجنسية / Egyptian Nationality</div>
                </div>

                <div class="data-grid">
                    <div class="data-item" style="grid-column: span 2; background: rgba(123, 0, 0, 0.03); padding: 12px; border-radius: 4px; margin-bottom: 5px;">
                        <div class="label-pair">
                            <span class="label-ar">الدرجة المهنية والتخصص</span>
                            <span class="label-en">Professional Rank & Specialization</span>
                        </div>
                        <div class="value-stack">
                            <span class="value-ar" id="view-rank-ar" style="color: var(--primary-dark); font-size: 13pt;">---</span>
                            <span class="value-en" id="view-rank-en" style="color: var(--primary-dark); font-size: 10pt;">---</span>
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم التصريح</span>
                            <span class="label-en">Permit Number</span>
                        </div>
                        <div class="value-stack">
                            <span class="value-ar value-num-ar" id="view-p-no-ar">---</span>
                            <span class="value-en value-num-en" id="view-p-no-en">---</span>
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">تاريخ انتهاء التصريح</span>
                            <span class="label-en">Permit Date of Expiry</span>
                        </div>
                        <div class="value-stack">
                            <span class="value-ar value-num-ar" id="view-expiry-date-ar" style="color: #d32f2f; font-size: 12pt;">--/--/----</span>
                            <span class="value-en value-num-en" id="view-expiry-date-en" style="color: #d32f2f; font-size: 10pt;">--/--/----</span>
                        </div>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم الهوية الوطنية</span>
                            <span class="label-en">National ID Number</span>
                        </div>
                        <div class="value-stack">
