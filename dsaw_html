        async function switchDatabase(dbName) {
            if (!dbName || !storageDirHandle) return;
            currentDbName = dbName;
            document.getElementById('db-selector').value = dbName;
            await loadDatabase();
        }

        async function createNewDatabase() {
            if (!storageDirHandle) {
                alert('يرجى تحديد المجلد أولاً.');
                return;
            }
            const name = prompt("أدخل اسم قاعدة البيانات الجديدة (بدون .json):");
            if (name) {
                const fileName = name.endsWith('.json') ? name : name + '.json';
                currentDbName = fileName;
                await saveToDatabase([]); // Create empty file
                await refreshDatabaseList();
                await switchDatabase(fileName);
            }
        }

        async function loadDatabase() {
            if (!storageDirHandle) return;
            try {
                const fileHandle = await storageDirHandle.getFileHandle(currentDbName, { create: true });
                const file = await fileHandle.getFile();
                const text = await file.text();
                DATABASE = (text && text.trim() !== "") ? JSON.parse(text) : [];
                console.log(`Database [${currentDbName}] loaded:`, DATABASE.length, "records");
            } catch (err) {
                console.error("Failed to load database:", err);
                DATABASE = [];
            }
        }

        async function saveToDatabase(entry = null) {
            if (!storageDirHandle) return;

            if (entry && !Array.isArray(entry)) {
                // Update or Add single record
                const index = DATABASE.findIndex(r => r.nid === entry.nid);
                if (index !== -1) {
                    DATABASE[index] = entry;
                } else {
                    DATABASE.push(entry);
                }
            } else if (Array.isArray(entry)) {
                DATABASE = entry;
            }

            try {
                const fileHandle = await storageDirHandle.getFileHandle(currentDbName, { create: true });
                const writable = await fileHandle.createWritable();
                await writable.write(JSON.stringify(DATABASE, null, 2));
                await writable.close();
            } catch (err) {
                console.error("Failed to save database index:", err);
            }
        }

