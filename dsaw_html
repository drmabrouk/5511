<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إصدار تصاريح مزاولة المهنة الاحترافي - V2.0</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;500;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #630000; /* أحمر خمري رسمي */
            --secondary-green: #004d40; /* أخضر غامق مؤسسي */
            --text-dark: #111;
            --watermark-color: rgba(220, 220, 220, 0.15); /* لون الخلفية المائية دقيق جداً */
            --bg-control: #f0f2f5;
        }

        * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body { font-family: 'Tajawal', sans-serif; margin: 0; background: var(--bg-control); display: flex; height: 100vh; overflow: hidden; color: var(--text-dark); }

        /* --- لوحة التحكم (Sidebar) --- */
        .sidebar {
            width: 380px; min-width: 380px; background: #fff; padding: 20px;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05); overflow-y: auto; z-index: 10;
            display: flex; flex-direction: column;
        }

        .sidebar-header { text-align: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        .sidebar-header h2 { color: var(--primary-dark); margin: 0; font-size: 1.3rem; font-weight: 800; }
        .sidebar-header p { color: #666; margin: 5px 0 0; font-size: 0.9rem; }
        
        .input-group { margin-bottom: 12px; }
        .input-group label { display: block; margin-bottom: 4px; font-weight: 500; font-size: 0.85rem; color: #444; }
        .input-group input, .input-group select {
            width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-family: 'Tajawal'; font-size: 0.9rem; transition: 0.2s;
        }
        .input-group input:focus, .input-group select:focus { border-color: var(--secondary-green); outline: none; box-shadow: 0 0 0 3px rgba(0,77,64,0.1); }

        .row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .btn-print {
            width: 100%; padding: 15px; background: var(--primary-dark); color: white; border: none;
            border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 1.1rem; margin-top: auto; transition: 0.3s;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .btn-print:hover { background: #4a0000; transform: translateY(-2px); }

        /* --- منطقة المعاينة (Preview) --- */
        .preview-area {
            flex-grow: 1; padding: 20px; display: flex; justify-content: center;
            align-items: flex-start; overflow-y: auto; background: #525659; /* لون خلفية عارض الملفات */
        }

        /* هيكلية وثيقة A4 - بدون إطارات */
        .a4-page {
            width: 210mm; height: 297mm; background: white; position: relative;
            box-shadow: 0 0 25px rgba(0,0,0,0.2); overflow: hidden;
            display: flex; flex-direction: column;
        }

        /* --- الخلفية المائية الأمنية الراقية (Guilloche Pattern) --- */
        /* تم استخدام SVG كخلفية لضمان الدقة والتموجات الوهمية المعقدة */
        .security-watermark {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 100 100"><g fill="none" stroke="rgba(200,200,200,0.10)" stroke-width="0.15"><path d="M0 50 C 20 20, 40 20, 50 50 S 80 80, 100 50" /><path d="M0 60 C 20 30, 40 30, 50 60 S 80 90, 100 60" /><path d="M0 40 C 20 10, 40 10, 50 40 S 80 70, 100 40" /><path d="M50 0 C 20 20, 20 40, 50 50 S 80 80, 50 100" /><path d="M60 0 C 30 20, 30 40, 60 50 S 90 80, 60 100" /><path d="M40 0 C 10 20, 10 40, 40 50 S 70 80, 40 100" /><ellipse cx="50" cy="50" rx="30" ry="15" transform="rotate(30 50 50)"/><ellipse cx="50" cy="50" rx="30" ry="15" transform="rotate(-30 50 50)"/></g></svg>');
            background-size: 150px 150px; /* حجم النمط المتكرر */
            pointer-events: none; z-index: 1;
        }

        /* المحتوى الفعلي للمستند */
        .doc-content {
            position: relative; z-index: 2;
            padding: 20mm 15mm 15mm 15mm; /* هوامش داخلية بروفيشنال */
            height: 100%; display: flex; flex-direction: column;
        }

        /* زخرفة علوية بسيطة جداً وغير بارزة بدلاً من الإطار */
        .doc-content::before {
            content: ''; position: absolute; top: 0; left: 15mm; right: 15mm; height: 4px;
            background: linear-gradient(to right, var(--primary-dark), var(--secondary-green), var(--primary-dark));
            border-radius: 0 0 4px 4px;
        }

        /* الهيدر */
        .header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 35px; padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .header-text { width: 38%; }
        .header-text.ar { text-align: right; font-family: 'Amiri', serif; font-size: 11pt; line-height: 1.4; }
        .header-text.en { text-align: left; font-family: 'Cambria', 'Georgia', serif; font-size: 10pt; line-height: 1.4; direction: ltr; }
        
        .logo-area { width: 24%; text-align: center; }
        #logo-preview { max-width: 90px; max-height: 90px; object-fit: contain; }

        /* عنوان الوثيقة */
        .doc-title { text-align: center; margin-bottom: 45px; }
        .doc-title h1 { margin: 0; color: var(--primary-dark); font-size: 26pt; font-family: 'Amiri', serif; font-weight: 700; }
        .doc-title p { margin: 5px 0 0; font-size: 15pt; color: #555; font-weight: 300; text-transform: uppercase; letter-spacing: 1px; }

        /* بيانات العضو الرئيسية */
        .member-name-zone { text-align: center; margin-bottom: 40px; position: relative; padding: 10px 0; }
        #view-name-ar { font-size: 20pt; font-weight: 800; color: #000; font-family: 'Tajawal', sans-serif; }
        #view-name-en { font-size: 14pt; color: #444; margin-top: 8px; font-family: 'Cambria', serif; font-weight: 400; font-style: italic; }

        /* شبكة البيانات الفنية */
        .data-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: x 25px;
            margin-top: 20px; border-top: 1px solid #eee; padding-top: 20px;
        }

        .data-item {
            border-bottom: 1px solid #f5f5f5; padding: 12px 0;
            display: flex; justify-content: space-between; align-items: baseline;
        }

        .data-item .label-pair { display: flex; flex-direction: column; text-align: right; }
        .data-item .label-ar { font-weight: 700; color: var(--secondary-green); font-size: 10.5pt; }
        .data-item .label-en { font-weight: 400; color: #777; font-size: 9pt; direction: ltr; text-align: right; }

        .data-item .value { font-weight: 700; font-size: 12pt; color: #000; font-family: 'Courier New', Courier, monospace; } /* خط مونو للأرقام */
        .data-item .value.text-val { font-family: 'Tajawal'; font-size: 11pt; }
        
        /* النص القانوني */
        .legal-text {
            margin-top: 40px; font-size: 9.5pt; line-height: 1.7; color: #666; text-align: justify;
            background: rgba(245, 245, 245, 0.5); padding: 15px; border-radius: 4px;
        }

        /* الفوتر */
        .footer-assets {
            margin-top: auto; display: flex; justify-content: space-between;
            align-items: flex-end; padding-top: 20px; border-top: 1px solid #eee;
        }

        .qr-box { width: 110px; text-align: center; }
        #qr-preview { width: 100px; height: 100px; border: 1px solid #eaeaea; padding: 2px; background: #fff; }
        .qr-box p { font-size: 8pt; margin: 8px 0 0; color: #777; line-height: 1.3; }

        .signature-box { text-align: center; min-width: 220px; color: var(--text-dark); }
        .signature-box .sig-line { border-top: 1.5px solid #333; margin-top: 55px; width: 100%; display: block; }
        .signature-box p { margin: 10px 0 0; font-weight: 700; font-size: 11pt; }
        .signature-box small { font-size: 9pt; color: #555; }

        /* --- إعدادات الطباعة الاحترافية --- */
        @media print {
            body { background: white; }
            .sidebar { display: none !important; }
            .preview-area { padding: 0; background: white; overflow: visible; }
            .a4-page {
                box-shadow: none; border: none;
                width: 210mm; height: 297mm;
                margin: 0; page-break-after: always;
            }
            /* تأكيد ظهور الخلفيات المائية عند الطباعة في بعض المتصفحات */
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <h2>بوابة إصدار التصاريح</h2>
            <p>أدخل البيانات بدقة لإنشاء المستند</p>
        </div>
        
        <div class="input-group">
            <label>شعار النقابة (رسمي)</label>
            <input type="file" id="logo-input" accept="image/*" onchange="loadImage(event, 'logo-preview')">
        </div>

        <div class="input-group">
            <label>اسم العضو الرباعي (عربي)</label>
            <input type="text" id="name-ar" placeholder="محمد أحمد محمود علي" oninput="updateText('view-name-ar', this.value)">
        </div>

        <div class="input-group">
            <label>Full Member Name (English)</label>
            <input type="text" id="name-en" style="direction: ltr;" placeholder="Mohamed A. Mahmoud Ali" oninput="updateText('view-name-en', this.value)">
        </div>

        <div class="input-group">
            <label>الدرجة المهنية / Professional Rank</label>
            <select id="rank" onchange="updateRank(this.value)">
                <option value="">اختر الدرجة...</option>
                <option value="مهندس استشاري | Consultant Engineer">مهندس استشاري | Consultant Engineer</option>
                <option value="مهندس أخصائي | Specialist Engineer">مهندس أخصائي | Specialist Engineer</option>
                <option value="مهندس ممارس | Practitioner Engineer">مهندس ممارس | Practitioner Engineer</option>
                <option value="محاسب قانوني | Chartered Accountant">محاسب قانوني | Chartered Accountant</option>
            </select>
        </div>

        <div class="row-inputs">
            <div class="input-group">
                <label>رقم التصريح (Permit)</label>
                <input type="text" id="p-no" placeholder="P-2023-001" oninput="updateText('view-p-no', this.value)">
            </div>
            <div class="input-group">
                <label>رقم القيد (Reg.)</label>
                <input type="text" id="r-no" placeholder="R-10550" oninput="updateText('view-r-no', this.value)">
            </div>
        </div>

        <div class="input-group">
            <label>رقم العضوية (Membership)</label>
            <input type="text" id="m-no" placeholder="M-9980" oninput="updateText('view-m-no', this.value)">
        </div>

        <div class="input-group">
            <label>رمز التحقق الرقمي (QR Code)</label>
            <input type="file" id="qr-input" accept="image/*" onchange="loadImage(event, 'qr-preview')">
        </div>

        <div style="margin-top: 15px; font-size: 0.8rem; color: #666; background: #f9f9f9; padding: 10px; border-radius: 4px; border: 1px solid #eee;">
            <strong>ملاحظة زمنية:</strong> تاريخ الإصدار هو تاريخ اليوم تلقائياً، وصلاحية التصريح سنة واحدة من تاريخه.
        </div>

        <button class="btn-print" onclick="window.print()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
            طباعة / حفظ PDF
        </button>
    </div>

    <div class="preview-area">
        <div class="a4-page" id="printable">
            <div class="security-watermark"></div>
            
            <div class="doc-content">
                
                <div class="header">
                    <div class="header-text ar">
                        <strong>المملكة العربية السعودية</strong><br>
                        الهيئة السعودية للمهنيين<br>
                        الإدارة العامة للتراخيص المهنية
                    </div>
                    <div class="logo-area">
                        <img id="logo-preview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><cyan cx='50' cy='50' r='45' stroke='%23630000' stroke-width='2' fill='none'/><path d='M30 70 L50 30 L70 70 M50 30 L50 70' stroke='%23004d40' stroke-width='3' fill='none'/></svg>" alt="Logo">
                    </div>
                    <div class="header-text en">
                        <strong>Kingdom of Saudi Arabia</strong><br>
                        Saudi Authority for Professionals<br>
                        General Dept. of Professional Licensure
                    </div>
                </div>

                <div class="doc-title">
                    <h1>تصريح مزاولة مهنة</h1>
                    <p>Professional Practice Permit</p>
                </div>

                <div class="member-name-zone">
                    <div id="view-name-ar">اسم العضو الكريم الرباعي</div>
                    <div id="view-name-en">Member Full English Name</div>
                </div>

                <div class="data-grid">
                    <div class="data-item" style="grid-column: span 2; background: rgba(99, 0, 0, 0.03); padding: 15px; border-radius: 4px;">
                        <div class="label-pair">
                            <span class="label-ar">الدرجة المهنية والتخصص</span>
                            <span class="label-en">Professional Rank & Specialization</span>
                        </div>
                        <span class="value text-val" id="view-rank" style="color: var(--primary-dark); font-size: 13pt;">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم التصريح</span>
                            <span class="label-en">Permit Number</span>
                        </div>
                        <span class="value" id="view-p-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم القيد ورتبته</span>
                            <span class="label-en">Registration No. & Rank</span>
                        </div>
                        <span class="value" id="view-r-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم العضوية النقابية</span>
                            <span class="label-en">Membership Number</span>
                        </div>
                        <span class="value" id="view-m-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">تاريخ صلاحية العضوية</span>
                            <span class="label-en">Membership Validity</span>
                        </div>
                        <span class="value" id="view-mem-expiry">--/--/----</span>
                    </div>

                    <div class="data-item" style="border-bottom: 2px solid var(--primary-dark);">
                        <div class="label-pair">
                            <span class="label-ar">تاريخ إصدار التصريح</span>
                            <span class="label-en">Permit Date of Issue</span>
                        </div>
                        <span class="value" id="view-issue-date">--/--/----</span>
                    </div>

                    <div class="data-item" style="border-bottom: 2px solid #d32f2f;">
                        <div class="label-pair">
                            <span class="label-ar">تاريخ انتهاء التصريح</span>
                            <span class="label-en">Permit Date of Expiry</span>
                        </div>
                        <span class="value" id="view-expiry-date" style="color: #d32f2f;">--/--/----</span>
                    </div>
                </div>

                <div class="legal-text">
                    يشهد القسم المختص بالهيئة بأن المذكور أعلاه مقيد بسجلاتنا ومصرّح له بمزاولة المهنة الموضحة تخصصها أعلاه، وذلك استناداً للأنظمة واللوائح التنفيذية. يجب تجديد هذا التصريح قبل تاريخ الانتهاء الموضح.
                    <br>
                    <small style="direction: ltr; display: block; text-align: left; margin-top: 5px;">This is to certify that the above-mentioned member is registered and licensed to practice the stated profession. This permit must be renewed before the expiry date.</small>
                </div>

                <div class="footer-assets">
                    <div class="qr-box">
                        <img id="qr-preview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='white'/><rect x='10' y='10' width='30' height='30' fill='%23333'/><rect x='60' y='10' width='30' height='30' fill='%23333'/><rect x='10' y='60' width='30' height='30' fill='%23333'/><rect x='50' y='50' width='10' height='10' fill='%23333'/><rect x='70' y='70' width='20' height='20' fill='%23333'/></svg>" alt="QR">
                        <p>للتلفّق الرقمي<br>Digital Verification</p>
                    </div>
                    <div class="signature-box">
                        <small>يعتمد،،،</small>
                        <span class="sig-line"></span>
                        <p>مدير عام التراخيص المهنية</p>
                        <small>Director General of Licensure</small>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>
        // دالة تحديث النصوص اللحظية
        function updateText(id, val) {
            const target = document.getElementById(id);
            if (val.trim() === "") {
                // إعادة النص الافتراضي في حال مسح الإدخال
                if (id.includes('ar')) target.innerText = "--- عربي ---";
                else if (id.includes('en')) target.innerText = "--- English ---";
                else target.innerText = "---";
            } else {
                target.innerText = val;
            }
        }

        // تحديث الدرجة المهنية (قائمة منسدلة)
        function updateRank(val) {
            document.getElementById('view-rank').innerText = val || '--- لم تحدد الدرجة ---';
        }

        // معالجة وتحميل الصور (الشعار و QR)
        function loadImage(event, targetId) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function() {
                const output = document.getElementById(targetId);
                output.src = reader.result;
                output.style.border = "none"; // إزالة الإطار الوهمي عند تحميل صورة حقيقية
            }
            reader.readAsDataURL(file);
        }

        // الأتمتة الزمنية عند تحميل الصفحة
        window.onload = function() {
            const today = new Date();
            
            // تاريخ الانتهاء (سنة واحدة)
            const expiry = new Date();
            expiry.setFullYear(today.getFullYear() + 1);

            // تاريخ صلاحية العضوية (فرضاً سنتين)
            const memExpiry = new Date();
            memExpiry.setFullYear(today.getFullYear() + 2);

            // دالة تنسيق التاريخ DD/MM/YYYY
            const formatDate = (date) => {
                let d = date.getDate().toString().padStart(2, '0');
                let m = (date.getMonth() + 1).toString().padStart(2, '0'); // الأشهر تبدأ من 0
                let y = date.getFullYear();
                return `${d}/${m}/${y}`;
            };

            // عرض التواريخ في المعاينة
            document.getElementById('view-issue-date').innerText = formatDate(today);
            document.getElementById('view-expiry-date').innerText = formatDate(expiry);
            document.getElementById('view-mem-expiry').innerText = formatDate(memExpiry);
        };
    </script>
</body>
</html>