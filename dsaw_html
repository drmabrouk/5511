<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إصدار تصاريح مزاولة المهنة الاحترافي - V2.0</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Tajawal:wght@300;500;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #7b0000; /* أحمر خمري رسمي */
            --secondary-green: #004d40; /* أخضر غامق مؤسسي */
            --text-dark: #111;
            --watermark-color: rgba(220, 220, 220, 0.15); /* لون الخلفية المائية دقيق جداً */
            --bg-control: #f0f2f5;
        }

        * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body { font-family: 'Tajawal', sans-serif; margin: 0; background: var(--bg-control); display: flex; height: 100vh; overflow: hidden; color: var(--text-dark); }

        /* --- لوحة التحكم (Sidebar) --- */
        .sidebar {
            width: 380px; min-width: 380px; background: #fff; padding: 20px;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05); overflow-y: auto; z-index: 10;
            display: flex; flex-direction: column;
        }

        .sidebar-header { text-align: center; margin-bottom: 25px; border-bottom: 2px solid #eee; padding-bottom: 15px; }
        .sidebar-header h2 { color: var(--primary-dark); margin: 0; font-size: 1.3rem; font-weight: 800; }
        .sidebar-header p { color: #666; margin: 5px 0 0; font-size: 0.9rem; }

        .input-group { margin-bottom: 12px; }
        .input-group label { display: block; margin-bottom: 4px; font-weight: 500; font-size: 0.85rem; color: #444; }
        .input-group input, .input-group select {
            width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-family: 'Tajawal'; font-size: 0.9rem; transition: 0.2s;
        }
        .input-group input:focus, .input-group select:focus { border-color: var(--secondary-green); outline: none; box-shadow: 0 0 0 3px rgba(0,77,64,0.1); }

        .row-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .btn-print {
            width: 100%; padding: 15px; background: var(--primary-dark); color: white; border: none;
            border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 1.1rem; margin-top: auto; transition: 0.3s;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .btn-print:hover { background: #4a0000; transform: translateY(-2px); }

        /* --- منطقة المعاينة (Preview) --- */
        .preview-area {
            flex-grow: 1; padding: 20px; display: flex; justify-content: center;
            align-items: flex-start; overflow-y: auto; background: #525659; /* لون خلفية عارض الملفات */
        }

        /* هيكلية وثيقة A4 - بدون إطارات */
        .a4-page {
            width: 210mm; height: 297mm; background: white; position: relative;
            box-shadow: 0 0 35px rgba(0,0,0,0.25); overflow: hidden;
            display: flex; flex-direction: column;
        }

        /* --- الخلفية المائية بنمط الأمواج الانسيابية (Wave-style Watermark) --- */
        .security-watermark {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 1000' preserveAspectRatio='none'><defs><linearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'><stop offset='0%25' stop-color='%237b0000' stop-opacity='0.012' /><stop offset='100%25' stop-color='%23004d40' stop-opacity='0.012' /></linearGradient></defs><path d='M-100,150 C200,50 400,250 600,150 S900,50 1100,150' fill='none' stroke='url(%23g)' stroke-width='1.5'/><path d='M-100,350 C100,450 500,250 700,350 S1000,450 1100,350' fill='none' stroke='url(%23g)' stroke-width='1.5'/><path d='M-100,550 C200,650 400,450 800,550 S1000,650 1100,550' fill='none' stroke='url(%23g)' stroke-width='1.5'/><path d='M-100,750 C100,850 500,650 700,750 S1000,850 1100,750' fill='none' stroke='url(%23g)' stroke-width='1.5'/><path d='M-100,950 C300,850 600,1050 1100,950' fill='none' stroke='url(%23g)' stroke-width='1.5'/></svg>");
            background-size: cover;
            pointer-events: none; z-index: 1;
        }

        /* المحتوى الفعلي للمستند */
        .doc-content {
            position: relative; z-index: 2;
            padding: 12mm 10mm;
            height: 100%; display: flex; flex-direction: column;
        }

        .doc-content::before {
            content: ''; position: absolute; top: 0; left: 15mm; right: 15mm; height: 4px;
            background: linear-gradient(to right, var(--primary-dark), var(--secondary-green), var(--primary-dark));
            border-radius: 0 0 4px 4px;
        }

        /* الهيدر */
        .header {
            display: flex; justify-content: space-between; align-items: flex-start;
            margin-bottom: 15px; padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .header-text { width: 38%; }
        .header-text.ar { text-align: right; font-family: 'Amiri', serif; font-size: 11pt; line-height: 1.4; }
        .header-text.en { text-align: left; font-family: 'Cambria', 'Georgia', serif; font-size: 10pt; line-height: 1.4; direction: ltr; }

        .logo-area { width: 24%; text-align: center; align-self: center; }
        #logo-preview { max-width: 80px; max-height: 80px; object-fit: contain; }

        /* عنوان الوثيقة */
        .doc-title { text-align: center; margin-bottom: 15px; }
        .doc-title h1 { margin: 0; color: var(--primary-dark); font-size: 24pt; font-family: 'Amiri', serif; font-weight: 700; letter-spacing: 0.5px; }
        .doc-title p { margin: 2px 0 0; font-size: 14pt; color: #555; font-weight: 300; text-transform: uppercase; letter-spacing: 1.5px; }

        /* بيانات العضو الرئيسية */
        .member-name-zone { text-align: center; margin-bottom: 15px; position: relative; padding: 5px 0; }
        #view-name-ar { font-size: 19pt; font-weight: 800; color: #000; font-family: 'Tajawal', sans-serif; }
        #view-name-en { font-size: 13pt; color: #444; margin-top: 5px; font-family: 'Cambria', serif; font-weight: 400; font-style: italic; }
        .member-qual-zone { font-size: 10pt; color: #555; margin-top: 8px; font-weight: 500; }

        /* شبكة البيانات الفنية */
        .data-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 8px 20px;
            margin-top: 10px; border-top: 1px solid #eee; padding-top: 10px;
        }

        .data-item {
            border-bottom: 1px solid #f5f5f5; padding: 8px 0;
            display: flex; justify-content: space-between; align-items: baseline;
        }

        .data-item .label-pair { display: flex; flex-direction: column; text-align: right; }
        .data-item .label-ar { font-weight: 700; color: var(--secondary-green); font-size: 10pt; }
        .data-item .label-en { font-weight: 400; color: #777; font-size: 8.5pt; direction: ltr; text-align: right; }

        .data-item .value { font-weight: 700; font-size: 11.5pt; color: #000; font-family: 'Courier New', Courier, monospace; }
        .data-item .value.text-val { font-family: 'Tajawal'; font-size: 10.5pt; }

        /* النص القانوني */
        .legal-text {
            margin-top: 15px; font-size: 9pt; line-height: 1.6; color: #444; text-align: justify;
            background: rgba(245, 245, 245, 0.5); padding: 12px; border-radius: 4px; border-right: 3px solid var(--secondary-green);
        }

        /* الفوتر */
        .footer-assets {
            margin-top: auto; display: flex; justify-content: space-between; margin-bottom: 10px;
            align-items: flex-end; padding-top: 10px; border-top: 1px solid #eee;
        }

        .qr-box { width: 110px; text-align: center; }
        #qr-preview { width: 90px; height: 90px; border: 1px solid #eaeaea; padding: 2px; background: #fff; }
        .qr-box p { font-size: 7.5pt; margin: 5px 0 0; color: #777; line-height: 1.2; }

        .signature-box { text-align: center; min-width: 200px; color: var(--text-dark); }
        .signature-box .sig-line { border-top: 1.5px solid #333; margin-top: 45px; width: 100%; display: block; }
        .signature-box p { margin: 8px 0 0; font-weight: 700; font-size: 10.5pt; }
        .signature-box small { font-size: 8.5pt; color: #555; }

        .verification-footer {
            text-align: center;
            font-size: 7.5pt;
            color: #888;
            border-top: 1px dashed #eee;
            padding-top: 8px;
            margin-top: 5px;
        }

        /* --- إعدادات الطباعة الاحترافية --- */
        @media print {
            body { background: white; }
            .sidebar { display: none !important; }
            .preview-area { padding: 0; background: white; overflow: visible; }
            .a4-page {
                box-shadow: none; border: none;
                width: 210mm; height: 297mm;
                margin: 0; page-break-after: always;
            }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">
            <h2>بوابة إصدار التصاريح</h2>
            <p>أدخل البيانات بدقة لإنشاء المستند</p>
        </div>

        <div class="input-group">
            <label>شعار النقابة (رسمي)</label>
            <input type="file" id="logo-input" accept="image/*" onchange="loadImage(event, 'logo-preview')">
        </div>

        <div class="input-group">
            <label>اسم العضو الرباعي (عربي)</label>
            <input type="text" id="name-ar" placeholder="محمد أحمد محمود علي" oninput="updateText('view-name-ar', this.value)">
        </div>

        <div class="input-group">
            <label>Full Member Name (English)</label>
            <input type="text" id="name-en" style="direction: ltr;" placeholder="Mohamed A. Mahmoud Ali" oninput="updateText('view-name-en', this.value)">
        </div>

        <div class="input-group">
            <label>المؤهل الدراسي / Academic Qualification</label>
            <select id="qual" onchange="updateQualInfo()">
                <option value="">اختر المؤهل...</option>
                <option value="بكالوريوس في علوم الرياضة | Bachelor of Sports Sciences">بكالوريوس في علوم الرياضة | Bachelor of Sports Sciences</option>
                <option value="ماجستير في علوم الرياضة – الصحة الرياضية | Master of Sports Sciences – Sports Health">ماجستير في علوم الرياضة – الصحة الرياضية | Master of Sports Sciences – Sports Health</option>
                <option value="دكتوراه في علوم الرياضة – الصحة الرياضية | PhD in Sports Sciences – Sports Health">دكتوراه في علوم الرياضة – الصحة الرياضية | PhD in Sports Sciences – Sports Health</option>
            </select>
        </div>

        <div class="input-group">
            <label>الدرجة المهنية / Professional Rank</label>
            <select id="rank" onchange="updateRank(this.value)">
                <option value="">اختر الدرجة...</option>
                <option value="أخصائي مساعد طبي | Medical Assistant Specialist">أخصائي مساعد طبي | Medical Assistant Specialist</option>
                <option value="أخصائي | Specialist">أخصائي | Specialist</option>
                <option value="استشاري | Consultant">استشاري | Consultant</option>
                <option value="خبير | Expert">خبير | Expert</option>
            </select>
        </div>

        <div class="input-group">
            <label>فرع النقابة / Syndicate Branch</label>
            <select id="branch" onchange="updateBranch(this.value)">
                <option value="">اختر الفرع...</option>
                <option value="القاهرة - Cairo">القاهرة - Cairo</option>
                <option value="المنوفية - Monufia">المنوفية - Monufia</option>
                <option value="الإسكندرية - Alexandria">الإسكندرية - Alexandria</option>
                <option value="الجيزة - Giza">الجيزة - Giza</option>
            </select>
        </div>

        <div class="row-inputs">
            <div class="input-group">
                <label>رقم التصريح (Permit)</label>
                <input type="text" id="p-no" placeholder="P-2023-001" oninput="updateText('view-p-no', this.value)">
            </div>
            <div class="input-group">
                <label>رقم القيد (Reg.)</label>
                <input type="text" id="r-no" placeholder="R-10550" oninput="updateText('view-r-no', this.value)">
            </div>
        </div>

        <div class="input-group">
            <label>رقم العضوية (Membership)</label>
            <input type="text" id="m-no" placeholder="M-9980" oninput="updateText('view-m-no', this.value)">
        </div>

        <div class="input-group">
            <label>رقم الهوية الوطنية / National ID Number</label>
            <input type="text" id="nid-no" maxlength="14" placeholder="29001011234567" oninput="this.value = this.value.replace(/[^0-9]/g, ''); updateText('view-nid-no', this.value)">
        </div>

        <div class="input-group">
            <label>رمز التحقق الرقمي (QR Code)</label>
            <input type="file" id="qr-input" accept="image/*" onchange="loadImage(event, 'qr-preview')">
        </div>

        <div style="margin-top: 15px; font-size: 0.8rem; color: #666; background: #f9f9f9; padding: 10px; border-radius: 4px; border: 1px solid #eee;">
            <strong>ملاحظة زمنية:</strong> صلاحية التصريح سنة واحدة من تاريخه.
        </div>

        <button class="btn-print" onclick="window.print()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"></path><path d="M6 14h12v8H6z"></path></svg>
            طباعة / حفظ PDF
        </button>
    </div>

    <div class="preview-area">
        <div class="a4-page" id="printable">
            <div class="security-watermark"></div>

            <div class="doc-content">

                <div class="header">
                    <div class="header-text ar">
                        <strong>جمهورية مصر العربية</strong><br>
                        نقابة الإصابات والتأهيل<br>
                        <span id="view-branch-ar" style="font-weight: bold; color: var(--secondary-green);"></span><br>
                    </div>
                    <div class="logo-area">
                        <img id="logo-preview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'> <circle cx='50' cy='50' r='45' stroke='%237b0000' stroke-width='2' fill='none'/><path d='M30 70 L50 30 L70 70 M50 30 L50 70' stroke='%23004d40' stroke-width='3' fill='none'/></svg>" alt="Logo">
                    </div>
                    <div class="header-text en">
                        <strong>Arab Republic of Egypt</strong><br>
                        Injuries and Rehabilitation Syndicate<br>
                        <span id="view-branch-en" style="font-weight: bold; color: var(--secondary-green);"></span><br>
                    </div>
                </div>

                <div class="doc-title">
                    <h1>تصريح مزاولة مهنة</h1>
                    <p>Professional Practice Permit</p>
                </div>

                <div class="member-name-zone">
                    <div id="view-name-ar">اسم العضو الكريم الرباعي</div>
                    <div id="view-name-en">Member Full English Name</div>
                </div>

                <div class="data-grid">
                    <div class="data-item" style="grid-column: span 2; background: rgba(123, 0, 0, 0.03); padding: 12px; border-radius: 4px;">
                        <div class="label-pair">
                            <span class="label-ar">الدرجة المهنية والتخصص</span>
                            <span class="label-en">Professional Rank & Specialization</span>
                        </div>
                        <span class="value text-val" id="view-rank" style="color: var(--primary-dark); font-size: 13pt;">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم التصريح</span>
                            <span class="label-en">Permit Number</span>
                        </div>
                        <span class="value" id="view-p-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم القيد ورتبته</span>
                            <span class="label-en">Registration No. & Rank</span>
                        </div>
                        <span class="value" id="view-r-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم العضوية النقابية</span>
                            <span class="label-en">Membership Number</span>
                        </div>
                        <span class="value" id="view-m-no">---</span>
                    </div>

                    <div class="data-item">
                        <div class="label-pair">
                            <span class="label-ar">رقم الهوية الوطنية</span>
                            <span class="label-en">National ID Number</span>
                        </div>
                        <span class="value" id="view-nid-no">---</span>
                    </div>

                    <div class="data-item" style="grid-column: span 2;">
                        <div class="label-pair">
                            <span class="label-ar">المؤهل الدراسي</span>
                            <span class="label-en">Academic Qualification</span>
                        </div>
                        <span class="value text-val" id="view-qual">---</span>
                    </div>


                    <div class="data-item" style="border-bottom: 2px solid #d32f2f; grid-column: span 2;">
                        <div class="label-pair">
                            <span class="label-ar">تاريخ انتهاء التصريح</span>
                            <span class="label-en">Permit Date of Expiry</span>
                        </div>
                        <span class="value" id="view-expiry-date" style="color: #d32f2f; font-size: 13pt;">--/--/----</span>
                    </div>
                </div>

                <div class="legal-text">
                    تشهد نقابة الإصابات والتأهيل بأن المذكور أعلاه مقيد بسجلاتنا ومصرّح له بمزاولة المهنة الموضحة تخصصها أعلاه، وذلك استناداً للأنظمة واللوائح التنفيذية. يجب تجديد هذا التصريح قبل تاريخ الانتهاء الموضح.
                    <br>
                    <small style="direction: ltr; display: block; text-align: left; margin-top: 5px;">This is to certify that the above-mentioned member is registered and licensed to practice the stated profession. This permit must be renewed before the expiry date.</small>
                </div>

                <div class="footer-assets">
                    <div class="qr-box">
                        <img id="qr-preview" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='white'/><rect x='10' y='10' width='30' height='30' fill='%23333'/><rect x='60' y='10' width='30' height='30' fill='%23333'/><rect x='10' y='60' width='30' height='30' fill='%23333'/><rect x='50' y='50' width='10' height='10' fill='%23333'/><rect x='70' y='70' width='20' height='20' fill='%23333'/></svg>" alt="QR">
                        <p>للتلفّق الرقمي<br>Digital Verification</p>
                    </div>
                    <div class="signature-box">
                        <small>يعتمد،،،</small>
                        <span class="sig-line"></span>
                        <p>نقيب الإصابات والتأهيل</p>
                        <small>Syndicate President</small>
                    </div>
                </div>

                <div class="verification-footer">
                    يمكن التحقق من صحة هذا التصريح عبر بوابة التحقق الإلكترونية باستخدام رقم التصريح أو رقم الهوية الوطنية:
                    <strong>irseg.org/verify</strong>
                    <br>
                    <span style="direction: ltr; display: inline-block; margin-top: 3px;">
                        Verification can be authenticated via the online portal using the permit or national ID number:
                        <strong>irseg.org/verify</strong>
                    </span>
                </div>

            </div>
        </div>
    </div>

    <script>
        // دالة تحديث النصوص اللحظية
        function updateText(id, val) {
            const target = document.getElementById(id);
            if (val.trim() === "") {
                if (id.includes('ar')) target.innerText = "---";
                else if (id.includes('en')) target.innerText = "---";
                else target.innerText = "---";
            } else {
                target.innerText = val;
            }
        }

        // تحديث الدرجة المهنية (قائمة منسدلة)
        function updateRank(val) {
            document.getElementById('view-rank').innerText = val || '---';
        }

        // تحديث معلومات المؤهل الدراسي
        function updateQualInfo() {
            const val = document.getElementById('qual').value;
            document.getElementById('view-qual').innerText = val || '---';
        }

        // تحديث فرع النقابة في الهيدر
        function updateBranch(val) {
            const arSpan = document.getElementById("view-branch-ar");
            const enSpan = document.getElementById("view-branch-en");
            if (val.includes(" - ")) {
                const parts = val.split(" - ");
                arSpan.innerText = parts[0];
                enSpan.innerText = parts[1];
            } else {
                arSpan.innerText = "";
                enSpan.innerText = "";
            }
        }

        // معالجة وتحميل الصور (الشعار و QR)
        function loadImage(event, targetId) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function() {
                const output = document.getElementById(targetId);
                output.src = reader.result;
                output.style.border = "none";
            }
            reader.readAsDataURL(file);
        }

        // الأتمتة الزمنية عند تحميل الصفحة
        window.onload = function() {
            const today = new Date();
            const expiry = new Date();
            expiry.setFullYear(today.getFullYear() + 1);

            const formatDate = (date) => {
                let d = date.getDate().toString().padStart(2, '0');
                let m = (date.getMonth() + 1).toString().padStart(2, '0');
                let y = date.getFullYear();
                return `${d}/${m}/${y}`;
            };

            document.getElementById('view-expiry-date').innerText = formatDate(expiry);
        };
    </script>
</body>
</html>
