        async function deleteCurrentRecord() {
            const nid = document.getElementById('nid-no').value;
            if (!nid || nid.length !== 14) {
                showToast('يرجى إدخال الرقم القومي الصحيح للحذف', 'error');
                return;
            }
            if (!confirm(`هل أنت متأكد من حذف السجل [${nid}]؟`)) return;

            const idx = DATABASE.findIndex(r => r.nid === nid);
            if (idx !== -1) {
                DATABASE.splice(idx, 1);
                await saveToDatabase(DATABASE);
                showToast('تم الحذف بنجاح');
                resetForm();
            } else {
                showToast('السجل غير موجود', 'error');
            }
        }

