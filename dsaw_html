                const writable = await fileHandle.createWritable();
                const content = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                await writable.write(content);
                await writable.close();

                // 2. تحديث الفهرس المركزي (JSON)
                await saveToDatabase(formData);

                showToast(`تم حفظ السجل ${formData.nid}`);
            } catch (err) {
                console.error('Save failed:', err);
                showToast('فشل في حفظ السجل', 'error');
            }
        }

        async function handlePrint() {
            await saveDocumentLocally();
            window.print();
        }

        // نظام البحث والفلترة
        function handleSearch(query) {
            const resultsDiv = document.getElementById('search-results');
            if (!query || query.length < 5) {
                resultsDiv.style.display = 'none';
                return;
            }

            const matches = DATABASE.filter(r =>
                r.nid.includes(query) ||
                (r.nameAr && r.nameAr.includes(query)) ||
                (r.nameEn && r.nameEn.toLowerCase().includes(query.toLowerCase()))
            );

            if (matches.length > 0) {
                resultsDiv.innerHTML = "";
                matches.forEach(r => {
                    const item = document.createElement('div');
                    item.className = 'search-item';
                    item.onclick = () => loadRecord(r.nid);

                    const name = document.createElement('strong');
                    name.textContent = r.nameAr || 'بدون اسم';

                    const meta = document.createElement('div');
                    meta.className = 'meta';
                    meta.textContent = `${r.nid} | ${r.pNo || '---'}`;

                    item.appendChild(name);
                    item.appendChild(meta);
                    resultsDiv.appendChild(item);
                });
                resultsDiv.style.display = 'block';
            } else {
                resultsDiv.innerHTML = '<div class="search-item" style="color:#999">لا توجد نتائج مطابقة...</div>';
                resultsDiv.style.display = 'block';
            }
        }

        function loadRecord(nid) {
            const record = DATABASE.find(r => r.nid === nid);
            if (!record) return;

            // ملء النموذج
            document.getElementById('nid-no').value = record.nid;
            document.getElementById('name-ar').value = record.nameAr || '';
            document.getElementById('name-en').value = record.nameEn || '';
            document.getElementById('code-no').value = record.codeNo || '';
            document.getElementById('uni').value = record.uni || '';
            document.getElementById('qual').value = record.qual || '';
            document.getElementById('acad-spec').value = record.acadSpec || '';
            document.getElementById('qual-date').value = record.qualDate || '';
            document.getElementById('rank').value = record.rank || '';
            document.getElementById('spec').value = record.spec || '';
            document.getElementById('branch').value = record.branch || '';
            document.getElementById('p-no').value = record.pNo || '';
            document.getElementById('r-no').value = record.rNo || '';
            document.getElementById('m-no').value = record.mNo || '';

            // استعادة تاريخ الإصدار إذا وجد
            if (record.issueDate) {
                document.getElementById('issue-date').value = record.issueDate;
            } else if (record.timestamp) {
                const issueDateObj = new Date(record.timestamp);
                const y = issueDateObj.getFullYear();
                const m = (issueDateObj.getMonth() + 1).toString().padStart(2, '0');
                const d = issueDateObj.getDate().toString().padStart(2, '0');
                document.getElementById('issue-date').value = `${y}-${m}-${d}`;
            }

            // تحديث المعاينة بالكامل
            syncAllToPreview();

            // استعادة تاريخ انتهاء التصريح من السجل (في حال كان مختلفاً عن الحساب التلقائي)
            if (record.expiryDate) {
                CURRENT_EXPIRY_DATE = record.expiryDate;
                document.getElementById('view-footer-expiry').innerText = `صالح حتى: ${toArabicDigits(record.expiryDate)} / Valid until: ${record.expiryDate}`;
            }

            document.getElementById('search-results').style.display = 'none';
            document.getElementById('search-db').value = '';
        }

        // الأتمتة الزمنية عند تحميل الصفحة
        window.onload = function() {
            populateDropdowns();
            autoRestoreSession();

            // تعيين القيم الافتراضية
            const defaults = {
                branch: "القاهرة - Cairo",
                uni: "جامعة القاهرة - Cairo University",
                qual: "بكالوريوس في علوم الرياضة | Bachelor of Sports Sciences",
                acadSpec: "الإصابات والتأهيل - Injuries and Rehabilitation",
                rank: "أخصائي - Specialist",
                spec: "الإصابات والتأهيل - Injuries and Rehabilitation"
            };

            const today = new Date();
            const lastYear = new Date();
            lastYear.setFullYear(today.getFullYear() - 1);
            const qualDateStr = lastYear.toLocaleString('ar-EG', { month: 'long' }) + " " + lastYear.getFullYear();

            // تعبئة النموذج بالقيم الافتراضية
            document.getElementById('branch').value = defaults.branch;
            document.getElementById('uni').value = defaults.uni;
            document.getElementById('qual').value = defaults.qual;
            document.getElementById('acad-spec').value = defaults.acadSpec;
            document.getElementById('qual-date').value = qualDateStr;
            document.getElementById('rank').value = defaults.rank;
            document.getElementById('spec').value = defaults.spec;

            // تعيين تاريخ الإصدار الافتراضي (اليوم)
            const y = today.getFullYear();
            const m = (today.getMonth() + 1).toString().padStart(2, '0');
            const d = today.getDate().toString().padStart(2, '0');
            document.getElementById('issue-date').value = `${y}-${m}-${d}`;

            // تحديث المعاينة فوراً
            syncAllToPreview();
        };
    </script>
</body>
